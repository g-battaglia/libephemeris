from pathlib import Path
from typing import ClassVar
from .minor_bodies import OrbitalElements
from .context import GeometricSpkSource

class ReboundIntegrator:
    IAS15: ClassVar[ReboundIntegrator]
    WHFAST: ClassVar[ReboundIntegrator]
    MERCURIUS: ClassVar[ReboundIntegrator]
    TRACE: ClassVar[ReboundIntegrator]
    LEAPFROG: ClassVar[ReboundIntegrator]
    def __init__(self, value: str) -> None: ...
    @property
    def value(self) -> str: ...
    @property
    def name(self) -> str: ...

class AssistEphemConfig:
    planets_file: str | None
    asteroids_file: str | None
    data_dir: str | None
    def __init__(self, planets_file: str | None = None,
                 asteroids_file: str | None = None,
                 data_dir: str | None = None) -> None: ...
    def propagate_curated(self, body: int, jd_tt: float) -> PropagationResult: ...
    def nbody_source(self, seed: GeometricSpkSource, anchor_tdb: float = 2451545.0) -> NbodySpkSource: ...

class NbodySpkSource:
    @property
    def anchor_tdb(self) -> float: ...
    def coverage_tdb(self) -> tuple[float, float]: ...
    def states_tdb(self, jd_tdb: list[float]) -> list[list[float]]: ...
    def states_tt(self, jd_tt: list[float]) -> list[list[float]]: ...

class PropagationResult:
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    jd_tt: float
    def __init__(self, x: float, y: float, z: float, vx: float,
                 vy: float, vz: float, jd_tt: float) -> None: ...
    @property
    def ecliptic_lon(self) -> float: ...
    @property
    def ecliptic_lat(self) -> float: ...
    @property
    def distance(self) -> float: ...
    def to_tuple(self) -> tuple[float, float, float, float, float, float]: ...

def check_rebound_available() -> bool: ...
def check_assist_available() -> bool: ...
def get_rebound_version() -> str | None: ...
def get_assist_version() -> str | None: ...
def propagate_orbit_rebound(elements: OrbitalElements, jd_start: float, jd_end: float,
                            integrator: ReboundIntegrator = ReboundIntegrator.IAS15,
                            dt: float | None = None) -> PropagationResult: ...
def propagate_orbit_assist(elements: OrbitalElements, jd_start: float, jd_end: float,
                           ephem_config: AssistEphemConfig | None = None,
                           include_non_gravitational: bool = False,
                           A1: float = 0.0, A2: float = 0.0, A3: float = 0.0) -> PropagationResult: ...
def propagate_trajectory(elements: OrbitalElements, jd_start: float, jd_end: float,
                         num_points: int = 100, use_assist: bool = True,
                         ephem_config: AssistEphemConfig | None = None,
                         integrator: ReboundIntegrator = ReboundIntegrator.IAS15) -> list[PropagationResult]: ...
def compare_with_keplerian(elements: OrbitalElements, jd_tt: float, use_assist: bool = False,
                           ephem_config: AssistEphemConfig | None = None) -> dict: ...

def download_assist_data(target_dir: str | None=None, planets: bool=True, asteroids: bool=True, planets_de441: bool=False, force: bool=False, show_progress: bool=True, quiet: bool=False) -> Path: ...
def check_assist_data_available() -> bool: ...
def reset_assist_data_cache() -> None: ...
def elements_to_rebound_orbit(elements: OrbitalElements, jd_tt: float) -> dict[str,float]: ...
