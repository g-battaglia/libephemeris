class LebStarRecord:
    """Immutable stored values, independent of the reader and built-in catalog."""
    @property
    def star_id(self) -> int:
        """File-local identifier, without HIP or other catalog remapping."""
        ...
    @property
    def ra_j2000_deg(self) -> float: ...
    @property
    def dec_j2000_deg(self) -> float: ...
    @property
    def pm_ra_deg_per_yr(self) -> float:
        """RA proper motion includes cos(dec), in degrees per year."""
        ...
    @property
    def pm_dec_deg_per_yr(self) -> float: ...
    @property
    def parallax_arcsec(self) -> float: ...
    @property
    def rv_km_per_s(self) -> float: ...
    @property
    def magnitude(self) -> float: ...

class LebReader:
    path: str
    jd_range: tuple[float, float]
    closed: bool
    def has_body(self, body_id: int) -> bool: ...
    def body_ids(self) -> list[int]: ...
    def eval_body(self, body_id: int, jd: float) -> tuple[list[float], list[float]]: ...
    def has_nutation(self) -> bool:
        """Probe the stored header only; backing/closed-handle errors propagate."""
        ...
    def eval_nutation(self, jd: float) -> tuple[float, float]:
        """Stored radians at TT JD; nonfinite or uncovered dates raise errors."""
        ...
    def delta_t(self, jd: float) -> float:
        """Stored TT-minus-UT1 in days; finite dates clamp at table endpoints."""
        ...
    def get_star(self, star_id: int) -> LebStarRecord:
        """Copy the selected file's record without conversion or propagation.

        Missing catalogs/IDs raise DataNotFoundError; closed/backing errors
        propagate. Last complete duplicate wins; trailing partial rows are ignored.
        Stored IEEE values are returned without physical validation.
        """
        ...
    def warm(self, jd_start: float, jd_end: float) -> int: ...
    def cool(self) -> None: ...
    def close(self) -> None: ...
