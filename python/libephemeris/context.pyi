"""Independent settings and retained native handles; see installed help()."""
from .state import LebReader

class DataLoader:
    """Obtain from a runtime; calling the loader acquires a retained SPK image."""
    @property
    def directory(self) -> str: ...
    def __call__(self, filename: str) -> PlanetaryEphemeris: ...
class TimeScale:
    """Independent frame-clock helpers; returned date pairs are additive TT."""
    def ut1_jd(self, jd: float) -> tuple[float, float]:
        """UT1 JD to (original_input, TT_minus_UT1_days), not (TT, UT1)."""
        ...
    def tt_jd(self, jd: float) -> tuple[float, float]:
        """Split TT into (floor(jd), fraction); no clock conversion."""
        ...
    def tdb_interval_to_tt(self, start: float, end: float) -> tuple[float, float]:
        """Return inward TT bounds for a closed TDB interval."""
        ...
class PlanetaryEphemeris:
    """Immutable image handle obtained from a loader or get_planets()."""
    @property
    def path(self) -> str: ...
    @property
    def filename(self) -> str: ...
    def geometric_state_tdb(self, naif_id: int, jd_tdb: float) -> tuple[list[float], list[float]]: ...
    def geometric_states_tdb(self, naif_id: int, jd_tdb: list[float]) -> list[list[float]]: ...
    def geometric_states_tt(self, naif_id: int, jd_tt: list[float]) -> list[list[float]]: ...
    def segment_descriptors_tdb(self) -> list[tuple[int, int, int, float, float]]: ...
    def geometric_source(self, naif_id: int, supporting: list[PlanetaryEphemeris] | None = None) -> GeometricSpkSource: ...
class GeometricSpkSource:
    """Fixed NAIF target; SSB ICRS/J2000 states without apparent corrections."""
    @property
    def naif_id(self) -> int: ...
    @property
    def paths(self) -> list[str]: ...
    def coverage_tdb(self) -> list[tuple[float, float]]: ...
    def state_tdb(self, jd_tdb: float) -> tuple[list[float], list[float]]: ...
    def states_tdb(self, jd_tdb: list[float]) -> list[list[float]]: ...
    def states_tt(self, jd_tt: list[float]) -> list[list[float]]: ...
