    def get_loader(self) -> DataLoader: ...
    def get_timescale(self) -> TimeScale: ...
    def get_planets(self) -> PlanetaryEphemeris: ...
    def set_leb_file(self, filepath: str | None) -> None: ...
    def get_leb_reader(self) -> LebReader | None: ...
    def set_topo(self, lon: float, lat: float, alt: float = 0.0) -> None: ...
    def get_topo(self) -> tuple[float, float, float] | None: ...
    def set_sid_mode(self, mode: int, t0: float = 0.0, ayan_t0: float = 0.0) -> None: ...
    def get_sid_mode(self, full: bool = False) -> int | tuple[int, float, float]: ...
    def get_angles_cache(self) -> dict[str, float]: ...
    def set_angles_cache(self, angles: dict[str, float]) -> None: ...
    def clear_angles_cache(self) -> None: ...
    def register_spk_body(self, ipl: int, spk_file: str, naif_id: int) -> None: ...
    def unregister_spk_body(self, ipl: int) -> None: ...
    def get_spk_body_info(self, ipl: int) -> tuple[str, int] | None: ...
    def list_spk_bodies(self) -> dict[int, tuple[str, int]]: ...
    def calc_ut(self, tjd_ut: float, ipl: int, iflag: int) -> tuple[tuple[float, float, float, float, float, float], int]: ...
    def calc(self, tjd: float, ipl: int, iflag: int) -> tuple[tuple[float, float, float, float, float, float], int]: ...
    def houses(self, tjd_ut: float, lat: float, lon: float, hsys: int) -> tuple[tuple[float, ...], tuple[float, ...]]: ...
    def calc_pctr(self, tjd_ut: float, ipl: int, iplctr: int, iflag: int) -> tuple[tuple[float, float, float, float, float, float], int]:
        """UT1 planet-centered entry; module-level calc_pctr instead takes TT."""
        ...
    @classmethod
    def close(cls) -> None: ...

