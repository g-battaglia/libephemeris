class PlanetCenterSegment:
    """Read-only NAIF/frame descriptor with inclusive TDB Julian-day bounds."""
    @property
    def target(self) -> int: ...
    @property
    def center(self) -> int: ...
    @property
    def frame(self) -> int: ...
    @property
    def start_jd(self) -> float: ...
    @property
    def end_jd(self) -> float: ...

class PlanetCenterTarget:
    """Retained target descriptors; obtain from get_planet_center_segment()."""
    @property
    def target(self) -> int: ...
    @property
    def paths(self) -> list[str]: ...
    @property
    def segments(self) -> list[PlanetCenterSegment]: ...

class PlanetCenters:
    """Retained companion-image metadata; obtain from get_planet_centers()."""
    @property
    def paths(self) -> list[str]: ...
    @property
    def segments(self) -> list[PlanetCenterSegment]: ...

