class BodyCoverage:
    body_id: int
    source: str
    precision_class: str
    jd_start: float
    jd_end: float
    data_file: str | None
    group: str | None
    reviewed: bool
    def __init__(self, body_id: int, source: str, precision_class: str, jd_start: float, jd_end: float, data_file: str | None, group: str | None, reviewed: bool) -> None: ...
    def contains(self, jd: float) -> bool: ...
    def to_dict(self) -> dict[str, Any]: ...

class RuntimeDataRequirement:
